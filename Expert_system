
rules = [
    {
        "gejala": ["daun menguning", "bintik cokelat"],
        "penyakit": "Hawa Daun Bakteri (Bacterial Leaf Blight)",
        "solusi": "Gunakan fungisida berbahan aktif tembaga dan kurangi pemupukan Nitrogen berlebih."
    },
    {
        "gejala": ["daun menguning", "batang melemah"],
        "penyakit": "Busuk Batang (Stem Rot)",
        "solusi": "Jaga drainase lahan agar tidak terlalu basah dan berikan agen hayati Trichoderma."
    },
    {
        "gejala": ["bintik cokelat", "bercak melingkar"],
        "penyakit": "Bercak Daun Cercospora",
        "solusi": "Lakukan rotasi tanaman dan semprotkan fungisida sistemik."
    },
    {
        "gejala": ["daun menguning"],
        "penyakit": "Defisiensi Nutrisi / Kekurangan Unsur Hara",
        "solusi": "Berikan pupuk susulan NPK yang seimbang."
    }
]

def jalankan_sistem_pakar(gejala_terpilih):
    print("\n" + "="*50)
    print("HASIL DIAGNOSIS SISTEM PAKAR")
    print("="*50)
    
    if not gejala_terpilih:
        print(" Anda belum memilih gejala apapun.")
        return

    print(f"Gejala yang dialami: {', '.join(gejala_terpilih)}")
    print("-" * 50)
    
    match_ditemukan = False
    
    for rule in rules:
        
        if all(g in gejala_terpilih for g in rule["gejala"]):
            match_ditemukan = True
            print(f" **Penyakit Terdeteksi:** {rule['penyakit']}")
            print(f" **Solusi Penanganan:** {rule['solusi']}")
            print("-" * 50)
            
    if not match_ditemukan:
        print(" Penyakit tidak dapat diidentifikasi dengan kombinasi gejala tersebut.")
        print("Saran: Konsultasikan langsung dengan ahli pertanian terdekat.")

if __name__ == "__main__":
    print("=== PROGRAM SISTEM PAKAR DIAGNOSIS TANAMAN ===")
    print("Pilih gejala yang tampak pada tanaman:")
    print("1. daun menguning")
    print("2. bintik cokelat")
    print("3. batang melemah")
    print("4. bercak melingkar")
    print("\nMasukkan nomor gejala yang dialami (pisahkan dengan koma, contoh: 1,2):")
    
    pilihan_map = {
        "1": "daun menguning",
        "2": "bintik cokelat",
        "3": "batang melemah",
        "4": "bercak melingkar"
    }
    
    input_user = input("Pilihan Anda: ")
    indeks_pilihan = [p.strip() for p in input_user.split(",")]
    
    gejala_user = []
    for p in indeks_pilihan:
        if p in pilihan_map:
            gejala_user.append(pilihan_map[p])
            
    jalankan_sistem_pakar(gejala_user)
