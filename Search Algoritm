from collections import deque
import heapq

# ==========================================
# 1. BREADTH-FIRST SEARCH (BFS)
# ==========================================
def bfs(graph, start, goal):
    queue = deque([[start]])
    visited = set()

    while queue:
        path = queue.popleft()
        node = path[-1]

        if node == goal:
            return path

        if node not in visited:
            visited.add(node)
            for neighbor in graph.get(node, []):
                new_path = list(path)
                new_path.append(neighbor)
                queue.append(new_path)

    return None


# ==========================================
# 2. DEPTH-FIRST SEARCH (DFS)
# ==========================================
def dfs(graph, start, goal, path=None, visited=None):
    if path is None:
        path = [start]
    if visited is None:
        visited = set()

    node = path[-1]

    if node == goal:
        return path

    visited.add(node)

    for neighbor in graph.get(node, []):
        if neighbor not in visited:
            new_path = list(path)
            new_path.append(neighbor)
            result = dfs(graph, start, goal, new_path, visited)
            if result:
                return result

    return None


# ==========================================
# 3. A* (A-STAR) SEARCH
# ==========================================
def a_star_search(graph, heuristic, start, goal):
    # Queue menyimpan tuple: (f_cost, current_node, path, g_cost)
    pq = [(heuristic[start], start, [start], 0)]
    visited = set()

    while pq:
        f, current, path, g = heapq.heappop(pq)

        if current == goal:
            return path, g

        if current in visited:
            continue
        visited.add(current)

        for neighbor, weight in graph.get(current, {}).items():
            if neighbor not in visited:
                new_g = g + weight
                new_f = new_g + heuristic[neighbor]
                heapq.heappush(pq, (new_f, neighbor, path + [neighbor], new_g))

    return None, float('inf')


# ==========================================
# DATA UJI COBA (GRAF & HEURISTIK)
# ==========================================

# Graf Unweighted (Untuk BFS dan DFS)
graph_unweighted = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F'],
    'D': ['G'],
    'E': ['G'],
    'F': ['G'],
    'G': []
}

# Graf Weighted (Untuk A* Search)
graph_weighted = {
    'A': {'B': 1, 'C': 4},
    'B': {'D': 2, 'E': 5},
    'C': {'F': 3},
    'D': {'G': 1},
    'E': {'G': 2},
    'F': {'G': 4},
    'G': {}
}

# Nilai Estimasi Heuristik ke 'G' (Untuk A*)
heuristic = {
    'A': 7,
    'B': 6,
    'C': 2,
    'D': 3,
    'E': 1,
    'F': 2,
    'G': 0
}


# ==========================================
# EKSEKUSI PROGRAM
# ==========================================
if __name__ == '__main__':
    start_node = 'A'
    goal_node = 'G'

    print("==========================================")
    print(f"PENCARIAN JALUR DARI '{start_node}' KE '{goal_node}'")
    print("==========================================")

    # 1. Jalankan BFS
    bfs_path = bfs(graph_unweighted, start_node, goal_node)
    print("\n1. Breadth-First Search (BFS):")
    print(f"   Jalur: {' -> '.join(bfs_path) if bfs_path else 'Tidak ditemukan'}")

    # 2. Jalankan DFS
    dfs_path = dfs(graph_unweighted, start_node, goal_node)
    print("\n2. Depth-First Search (DFS):")
    print(f"   Jalur: {' -> '.join(dfs_path) if dfs_path else 'Tidak ditemukan'}")

    # 3. Jalankan A* Search
    astar_path, astar_cost = a_star_search(graph_weighted, heuristic, start_node, goal_node)
    print("\n3. A* (A-Star) Search:")
    if astar_path:
        print(f"   Jalur: {' -> '.join(astar_path)}")
        print(f"   Total Biaya (Cost): {astar_cost}")
    else:
        print("   Jalur tidak ditemukan")

    print("==========================================")
