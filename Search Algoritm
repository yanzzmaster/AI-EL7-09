"""
======================================================================
Forward Chaining Search Algorithm - Diagnosis Penyakit Tanaman
======================================================================
"""

# 1. KUMPULAN DATA GEJALA (FACTS)
GEJALA = {
    "1": "Daun menguning dan layu",
    "2": "Bercak cokelat atau hitam pada daun",
    "3": "Batang membusuk dan berbau busuk",
    "4": "Pertumbuhan tanaman kerdil atau terhambat"
}

# 2. BASIS PENGETAHUAN / RULES (KNOWLEDGE BASE)
RULES = [
    {
        "penyakit": "Penyakit Busuk Batang",
        "gejala_butuh": {"1", "3"},
        "solusi": "Pangkas bagian busuk, kurangi penyiraman, dan berikan fungisida/bakterisida."
    },
    {
        "penyakit": "Penyakit Bercak Daun",
        "gejala_butuh": {"2"},
        "solusi": "Buang daun terinfeksi dan semprotkan fungisida secara berkala."
    },
    {
        "penyakit": "Defisiensi Nutrisi (Kekurangan Unsur Hara)",
        "gejala_butuh": {"1", "4"},
        "solusi": "Berikan pupuk NPK dan periksa pH tanah."
    },
    {
        "penyakit": "Infeksi Virus / Hama Akar",
        "gejala_butuh": {"2", "4"},
        "solusi": "Gunakan nematisida atau isolasi tanaman dari tanaman lain."
    }
]

# 3. SEARCH ENGINE (FORWARD CHAINING)
def forward_chaining_search(fakta_gejala):
    fakta_set = set(fakta_gejala)
    hasil_penyakit = []

    # Melakukan pencarian dari fakta yang ada menuju aturan yang cocok
    for rule in RULES:
        if rule["gejala_butuh"].issubset(fakta_set):
            hasil_penyakit.append(rule)

    return hasil_penyakit

# 4. INTERFACE CLI
def main():
    print("======================================================================")
    print("      DIAGNOSIS PENYAKIT TANAMAN (FORWARD CHAINING SEARCH)")
    print("======================================================================")
    print("Daftar Gejala:")
    for kode, nama in GEJALA.items():
        print(f" [{kode}] {nama}")
    print("----------------------------------------------------------------------")
    
    user_input = input("Masukkan nomor gejala (pisahkan dengan koma, contoh: 1,3): ").strip()
    
    if not user_input:
        print("Input kosong.")
        return

    # Parsing input
    gejala_terpilih = [g.strip() for g in user_input.split(",") if g.strip() in GEJALA]

    if not gejala_terpilih:
        print("Gejala tidak ditemukan/tidak valid.")
        return

    print("\n[+] Gejala terdeteksi:")
    for g in gejala_terpilih:
        print(f"    - {GEJALA[g]}")

    # Eksekusi algoritma pencarian
    hasil_search = forward_chaining_search(gejala_terpilih)

    print("\n======================================================================")
    print("HASIL DIAGNOSIS (GOAL):")
    print("======================================================================")
    if hasil_search:
        for idx, res in enumerate(hasil_search, 1):
            print(f"\n{idx}. Penyakit : {res['penyakit']}")
            print(f"   Solusi   : {res['solusi']}")
    else:
        print("\nTidak ditemukan diagnosis yang cocok untuk kombinasi gejala tersebut.")

if __name__ == "__main__":
    main()
